# --- Frontend (exposed to the browser, safe to be public) ---
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Server-side only (Vercel env vars — NEVER prefix with VITE_) ---
# Supabase service_role key: full DB access, used by /api functions only.
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared Anthropic key that powers "Generate with Claude" for permitted users.
ANTHROPIC_API_KEY=sk-ant-...

# Resend, for sending invite emails (optional — without it, invite links are
# returned to the admin to share manually).
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Quiztoad <invites@yourdomain.com>

# Where invite links should redirect (your deployed app URL).
APP_URL=https://your-app.vercel.app
